DATABASE_URL=postgresql://...         # PostgreSQL connection string
BETTER_AUTH_SECRET=random-32-char+    # Min 32 chars
BETTER_AUTH_URL=https://obws.fi       # Base URL for auth callbacks
RESEND_API_KEY=re_...                 # Resend API key
NEXT_PUBLIC_SITE_URL=https://obws.fi

# --- Membership card (Apple + Google Wallet) ---
MEMBERSHIP_CARD_SECRET=random-32-char+   # HMAC secret for the QR token

# Apple Wallet (requires Apple Developer account). Cert/key blobs base64-encoded.
APPLE_PASS_TYPE_ID=pass.fi.obws.membership
APPLE_TEAM_ID=ABCDE12345                  # 10-char Apple Team ID
APPLE_PASS_CERT=base64(pass-cert.pem)     # Pass Type ID certificate (PEM)
APPLE_PASS_KEY=base64(pass-key.pem)       # Private key (PEM)
APPLE_PASS_KEY_PASSPHRASE=                # Passphrase for the key (if any)
APPLE_WWDR_CERT=base64(wwdr-g4.pem)       # Apple WWDR intermediate cert (PEM)
# APNs push for live pass updates (Apple Developer → Keys → APNs .p8 key)
APPLE_APNS_KEY=base64(AuthKey_XXXX.p8)    # APNs token signing key (.p8, PEM)
APPLE_APNS_KEY_ID=ABCD1234EF               # The Key ID of the .p8 key

# Google Wallet (free). From the Google Cloud service account + Wallet Console.
GOOGLE_WALLET_ISSUER_ID=3388000000022000000
GOOGLE_WALLET_SA_EMAIL=wallet@project.iam.gserviceaccount.com
GOOGLE_WALLET_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_WALLET_CLASS_SUFFIX=obws-membership
