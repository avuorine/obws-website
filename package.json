{
  "name": "obws-website",
  "version": "1.0.0",
  "description": "Österbottens Whiskysällskap rf website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "docker compose up -d && next dev",
    "devsafe": "rm -rf .next && next dev",
    "lint": "next lint",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "db:seed-categories": "tsx scripts/seed-event-categories.ts",
    "db:seed-invoice-counter": "tsx scripts/seed-invoice-counter.ts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.5",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/analytics": "^1.6.1",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "16.4.7",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.7.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^0.563.0",
    "next": "15.5.25",
    "next-intl": "^4.14.5",
    "passkit-generator": "^3.6.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^9.13.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-phone-number-input": "^3.4.18",
    "resend": "^6.28.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.5.25",
    "jsdom": "26.1.0",
    "nodemailer": "^8.0.1",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
